<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header line with ornament & title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="شعار"
            android:src="@drawable/app_launcher_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="ذكر التوحيد"
            android:textColor="#7A6843"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/widget_btn_switch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="تبديل العبارة"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap" />
    </LinearLayout>

    <!-- Main Phrase in Black Color -->
    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:text="(لا إله إلا الله)"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Footer tip -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اضغط للتبديل أو الفتح"
        android:textColor="#9E927A"
        android:textSize="10sp" />

</LinearLayout>
